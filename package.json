{
  "name": "chalista-academy",
  "version": "0.1.0",
  "private": true,
  "description": "Chalista Academy — platform kursus online dengan kelas live via Zoom",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:learn": "pnpm --filter @chalista/learn dev",
    "dev:server": "pnpm --filter @chalista/server dev",
    "dev:zoom": "pnpm --filter @chalista/zoom dev",
    "build": "pnpm -r build",
    "build:learn": "pnpm --filter @chalista/learn build",
    "build:server": "pnpm --filter @chalista/server build",
    "build:zoom": "pnpm --filter @chalista/zoom build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "eslint-plugin-perfectionist": "^5.11.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.10.0"
}
