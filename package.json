{
  "name": "chalista-academy",
  "version": "0.1.0",
  "private": true,
  "description": "Chalista Academy — platform kursus online dengan kelas live via Zoom",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
