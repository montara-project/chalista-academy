{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "react",
    "react-perf",
    "jsx-a11y",
    "promise",
    "node",
    "import"
  ],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "settings": {},
  "overrides": [
    {
      "files": ["apps/learn/**", "apps/zoom-client/**", "packages/ui/**"],
      "plugins": ["typescript", "unicorn", "react", "react-perf", "jsx-a11y", "promise", "import"],
      "env": {
        "browser": true,
        "es2024": true
      }
    },
    {
      "files": ["apps/server/**", "packages/api-client/**"],
      "env": {
        "node": true,
        "es2024": true
      }
    }
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.vinext/**",
    "**/.wrangler/**",
    "**/.next/**",
    "**/coverage/**",
    "**/*.d.ts"
  ]
}
