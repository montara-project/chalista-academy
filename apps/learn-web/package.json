{
  "name": "@chalista/learn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "prebuild": "npm-run-all fmt lint:fix typecheck",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "preview": "npm run build && npm run start --",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./worker-configuration.d.ts",
    "lint": "oxlint",
    "lint:init": "oxlint --init",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:init": "oxfmt --init",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@vinext/cloudflare": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "latest",
    "vinext": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/node": "^26.4.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "eslint-plugin-perfectionist": "^5.11.0",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "^4.129.0"
  },
  "engines": {
    "node": ">=22.0"
  },
  "packageManager": "npm@11.6.2"
}
