{
  "name": "@chalista/server",
  "version": "0.1.0",
  "private": true,
  "description": "API Chalista Academy (hono, Cloudflare Workers)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "dev:node": "tsx watch src/local.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@chalista/types": "workspace:*",
    "hono": "^4.13.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@chalista/config": "workspace:*",
    "@cloudflare/workers-types": "^4.20250903.0",
    "@hono/node-server": "^1.19.0",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.38.0"
  }
}
