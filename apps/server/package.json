{
  "name": "@chalista/server",
  "version": "0.1.0",
  "private": true,
  "description": "API Chalista Academy (hono, Node.js)",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run build:watch\" \"npm run watch-dev\"",
    "build:watch": "tsc && (concurrently \"tsc -w\" \"tsc-alias -w\")",
    "watch-dev": "nodemon --watch \"apps/server/dist/**/*\" -e js ./apps/server/dist/main.js",
    "clean": "rimraf dist",
    "prebuild": "npm-run-all clean",
    "build": "tsc && tsc-alias",
    "start": "node ./dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chalista/types": "workspace:*",
    "@dotenvx/dotenvx": "^2.23.0",
    "@hono/node-server": "^1.19.0",
    "@hono/zod-validator": "^0.9.1",
    "@sentry/hono": "^10.73.0",
    "@sentry/node": "^10.73.0",
    "argon2": "^0.45.1",
    "concurrently": "^10.0.5",
    "date-fns": "^4.4.0",
    "hono": "^4.13.5",
    "hono-rate-limiter": "^0.5.3",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "node": "link:@sentry/hono/node",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.1",
    "ua-parser-js": "^2.0.10",
    "uuid": "^14.0.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@chalista/config": "workspace:*",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.3.0",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.9.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  }
}
