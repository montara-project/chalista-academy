// Konfigurasi Cloudflare Workers untuk API Chalista Academy.
// Deploy: `pnpm --filter @chalista/server deploy` (butuh `wrangler login`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chalista-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true,
  },
}
